# Custom Commands

sys-life() {

    # Store numeric time values to calculate time since system installation

    local home_dir_timestamp=$(stat -c %W /home);
    local seconds_passed=$(date +%s);
    local days_passed=$(((seconds_passed - home_dir_timestamp) / 86400))

    # Show message to user with calculated time in days format

    case $days_passed in
      0) echo "Freshly installed and ready to serve!" ;;
      1) echo "Welcome to your new system. Did you install everything you need?" ;;
      7) echo "A week has passed and you're still here. Nice!" ;;
      14) echo "Two weeks passed. Is it getting comfortable?" ;;
      30) echo "A month has passed. You seem to like it here." ;;
      50) echo "That's a trip from Japan to Egypt. The world opens up for you." ;;
      100) echo "That's a statement. Either for your determination - or your laziness." ;;
      120) echo "That's all powerstars collected. So long-a, Bowser." ;;
      150) echo "A system made to last." ;;
      *) echo "The system has been running for $days_passed days." ;;
    esac

}

sql-init() {
 
  # Change this if you need a specific mariadb version or container name.
 
  local image="mariadb:lts"
  local container_name="sql-server"

  # This will delete the old container, so BE careful!

  if podman container exists "$container_name"; then
    echo "Old container found. Deleting now..."; 
    podman rm -f -- "$container_name";
  fi
  
  podman pull "docker.io/$image" || { echo "Couldn't pull image. Aborting operation." && return 1; }
  podman run --detach --name "$container_name" --env MARIADB_ALLOW_EMPTY_ROOT_PASSWORD=1 -p 3306:3306 "$image";

  echo "MariaDB has been successfully deployed and started."
  echo "You can stop the container by typing 'podman stop $container_name'."

}

dbox-init() {
  
  # Creation of directories should be handled by the Nivox Jumpstarter script.

  local dbox_root="$HOME/.distroboxes"
  local dbox_conf="$HOME/.local/share/nivox"

  # Setting up a separate environment in your users' home.

  echo "Setting up a dedicated environment in $box_root..."
  mkdir -p "$dbox_root"

  # Check for distrobox configuration file and execute it.

  echo "Building distroboxes..."
  [ -f "$dbox_conf/devel.ini"  ] || { echo "The init file for distrobox is missing. Aborting." && return 1; }
  distrobox assemble create --file "$box_conf/devel.ini" || { echo "Couldn't build the init file. Aborting." && return 1; }

  # Check for bootsrap script and execute it.

  echo "Bootstrapping Development environments..."
  [ -f "$dbox_conf/bootstrap.sh"  ] || { echo "The bootstrap file for distrobox is missing. Aborting." && return 1; }
  bash "$box_conf/bootstrap.sh"

}
